# Global runtime defaults for local operator use.
APP_RUNTIME_MODE=backend-only
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
APP_API_TOKEN=
DATABASE_URL=postgresql+psycopg://11writer:11writer@127.0.0.1:5432/11writer

# Local-only feed placeholders. Do not commit real tokenized or private feed URLs.
RSS_FEED_SOURCE_MODE=fixture
RSS_FEED_FIXTURE_PATH=./app/server/data/rss_google_alerts_fixture.xml
RSS_FEED_URL=https://example.invalid/private-rss-or-atom-feed-url
RSS_FEED_NAME=local-discovery-feed
RSS_FEED_STALE_AFTER_SECONDS=172800
