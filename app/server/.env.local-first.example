ELEVENWRITER_APP_ENV=local
ELEVENWRITER_DATABASE_URL=sqlite:///./var/11writer_forte.db
ELEVENWRITER_DATABASE_AUTO_MIGRATE=true
ELEVENWRITER_DATA_DIR=./var

# Persist every cached payload, archive artifact, and rehydrated object locally.
ELEVENWRITER_STORAGE_ARCHIVE_BACKEND=local
ELEVENWRITER_STORAGE_ARCHIVE_DIR=artifacts/archive
ELEVENWRITER_STORAGE_REHYDRATE_DIR=artifacts/rehydrated

# Optional self-hosted analytics. Leave disabled unless you are running local ClickHouse.
ELEVENWRITER_CLICKHOUSE_ENABLED=false
ELEVENWRITER_CLICKHOUSE_URL=http://127.0.0.1:8123
ELEVENWRITER_CLICKHOUSE_DATABASE=elevenwriter
ELEVENWRITER_CLICKHOUSE_USER=default
ELEVENWRITER_CLICKHOUSE_PASSWORD=

# Leave all cloud / R2 values blank in local-first mode.
ELEVENWRITER_CLICKHOUSE_R2_ENDPOINT=
ELEVENWRITER_CLICKHOUSE_R2_BUCKET=
ELEVENWRITER_CLICKHOUSE_R2_ACCESS_KEY_ID=
ELEVENWRITER_CLICKHOUSE_R2_SECRET_ACCESS_KEY=
